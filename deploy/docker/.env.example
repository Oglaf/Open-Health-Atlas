# Copy to deploy/docker/.env and fill in real values; do not commit the
# populated file (deploy/docker/.env is covered by the repository .gitignore
# pattern for .env*). See ../../docs/DOCKER.md for the full operator guide.

# Which image/tag to run. The default matches this branch's published tag;
# override for a pinned release once one exists (e.g. OHA_TAG=v1.0.0).
OHA_IMAGE=ghcr.io/oglaf/open-health-atlas
OHA_TAG=multi-user

# Required. Generate a long random value for every installation and keep it
# stable afterward — every restart with a different value invalidates all
# sessions, pending passkey challenges and CSRF tokens.
#   openssl rand -hex 32
PANEL_SECRET_KEY=replace-with-a-random-secret

# WebAuthn relying party. MUST be the public HTTPS host/origin the reverse
# proxy terminates for you, set correctly BEFORE the first passkey enrolment
# (passkeys are bound to the origin they were created under). Keep both
# stable after enrolling; changing them strands existing passkeys.
PANEL_RP_ID=panel.example.invalid
PANEL_ORIGIN=https://panel.example.invalid
# 1 behind HTTPS (the only supported production setting — passkeys require a
# secure context); 0 only for the commented-out plain-http local test mapping
# in docker-compose.yml.
PANEL_COOKIE_SECURE=1

HERMES_TIMEZONE=UTC
HERMES_DISPLAY_NAME=OpenHealthAtlas user
# Stable legacy single-user WebAuthn identity fields; irrelevant once every
# user has been migrated off the bootstrap `owner` account but safe to leave.
PANEL_USER_ID=hermes-user
PANEL_USER_NAME=hermes-user

# Neutral default used by medication charts. Change to the exact label used in
# your own meds_log. Optional comma-separated aliases remain local.
HERMES_PRIMARY_MEDICATION=medication
HERMES_MEDICATION_ALIASES=

# Optional per-user nutrient targets. No demographic targets are assumed when
# this is empty.
HERMES_NUTRIENT_TARGETS_JSON={}
HERMES_SIT_REACH_NORMAL_CM=
HERMES_PHASE_OFFSETS_JSON={}
HERMES_PROTEIN_PER_KG_JSON={}
HERMES_WATER_FALLBACK_ML=2000
HERMES_WATER_ML_PER_KG=30
HERMES_WATER_ML_PER_EXERCISE_HOUR=500
HERMES_WATER_HOT_DAY_BONUS_ML=300
HERMES_WATER_HOT_DAY_TEMP_C=26
